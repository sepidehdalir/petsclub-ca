# ==============================================================================
# PetsClub.ca — environment variables
# ==============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#
# NEVER commit real keys, database passwords or OAuth secrets to this file.
# Only placeholder values belong here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------------
# Canonical origin used for metadata, canonical URLs, sitemap and Open Graph.
# Production must be the real domain — never localhost.
#   local:      http://localhost:3000
#   production: https://petsclub.ca
# If unset, the app falls back to VERCEL_PROJECT_PRODUCTION_URL (injected by
# Vercel) and finally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ------------------------------------------------------------------------------
# Project Settings -> API. The anon key is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Supabase — server only (NEVER expose to the browser)
# ------------------------------------------------------------------------------
# Bypasses Row Level Security completely. Required only for privileged
# server-side operations (moderation/admin tooling, Milestone 6).
# Do not prefix with NEXT_PUBLIC_. Do not reference from Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string, used only by local tooling to apply
# migrations and the taxonomy seed. Not read by the application at runtime.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Email (Resend) — reserved, not yet wired up
# ------------------------------------------------------------------------------
# Transactional email currently goes through Supabase Auth's built-in sender.
# The application reads this key only once custom email templates ship.
# RESEND_API_KEY=your-resend-api-key
