# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials.
# .env.example is the documented, value-free template and is intentionally tracked.
.env
.env.*
!.env.example

# vercel
.vercel

# supabase local tooling
/supabase/.temp
/supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/editor settings
.claude/settings.local.json
